{
  "manifest_version": 3,
  "name": "Gemini Image Original Downloader",
  "version": "1.0",
  "description": "Download original resolution images from Gemini's 'Made with Gemini' page.",
  "permissions": [
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
