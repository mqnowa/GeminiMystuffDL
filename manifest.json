{
  "manifest_version": 3,
  "name": "Gemini Image Original Downloader",
  "version": "1.0",
  "description": "Download original resolution images from Gemini's 'Made with Gemini' page.",
  "permissions": [
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/mystuff",
        "https://gemini.google.com/mystuff/*",
        "https://gemini.google.com/u/*/mystuff",
        "https://gemini.google.com/u/*/mystuff/*"
      ],
      "js": [
        "mystuff.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://gemini.google.com/app/*",
        "https://gemini.google.com/u/*/app/*"
      ],
      "js": [
        "app.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
